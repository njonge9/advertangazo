<layout-columns class="columns is-centered">
  <layout-column class="column box is-5 mt-6 p-5 m-4">
    <h1 class="title has-text-centered">
      Log in
    </h1>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="block">
        <%= f.label :email, class:"label" %>
        <%= f.email_field :email, class:"input", autofocus: true, autocomplete: "email" %>
      </div>

      <div class="block">
        <%= f.label :password, class:"label" %>
        <%= f.password_field :password, class: "input", autocomplete: "current-password" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="block is-flex is-justify-content-center">
          <%= f.check_box :remember_me, class: "checkbox" %>
          <%= f.label :remember_me, class: "label" %>
        </div>
      <% end %>

      <div class="is-flex is-justify-content-center">
        <%= f.submit "Log in", class: "button is-large is-primary mt-3" %>
      </div>
    <% end %>.

    <div class="is-flex is-justify-content-center">
      <%= link_to "Sign Up", new_user_registration_path, class: "is-small is-link mr-3  button"%>
      <%= link_to "Forgot password?", new_user_password_path, class: "button is-small ml-3 is-link "%>
    </div>

  </layout-column>
</layout-columns>


