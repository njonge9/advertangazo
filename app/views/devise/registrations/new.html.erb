<layout-columns class="columns is-centered">
  <layout-column class="column box is-5 mt-6 p-5 m-5">
    <h1 class="title has-text-centered">
      Sign up
    </h1>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), class: "is-flex is-flex-direction-column") do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="block">
        <%= f.label :name, class: "label" %>
        <%= f.text_field :name, class: "input", autofocus: true %>
      </div>

      <div class="block">
        <%= f.label :email, class: "label" %>
        <%= f.email_field :email, class: "input", autofocus: true, autocomplete: "email" %>
      </div>

      <div class="block">
        <%= f.label :password, class: "label" %>
        <% if @minimum_password_length %>
        <em>(<%= @minimum_password_length %> characters minimum)</em>
        <% end %><br />
        <%= f.password_field :password, class: "input", autocomplete: "new-password" %>
      </div>

      <div class="block">
        <%= f.label :password_confirmation, class: "label" %>
        <%= f.password_field :password_confirmation, class: "input", autocomplete: "new-password" %>
      </div>

      <!-- Centering the Submit Button -->
      <div class="is-flex is-justify-content-center">
        <%= f.submit "Sign up", class: "button is-primary is-large mb-3 mt-3 mr-3" %>
        <%= link_to "Login", new_user_session_path, class: "is-black is-large mb-3 mt-3 button ml-3"%>
      </div>

    <% end %>
  </layout-column>
</layout-columns>
